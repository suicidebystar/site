---
import { Image } from "astro:assets";
import logo from "@images/logo.png";
import NewTabNote from "../NewTabNote/NewTabNote.astro";
import "./header.scss";

const sections = [
  { href: "/category/regular-show/", label: "Programas" },
  { href: "/category/monograph/", label: "Monográficos" },
];
const archiveUrl = "https://archivo.suicidebystar.sbs";

// Prefix match so paginated category pages keep their section marked.
const isCurrent = (href: string) =>
  href === "/"
    ? Astro.url.pathname === "/"
    : Astro.url.pathname.startsWith(href);
const ariaCurrent = (href: string) => (isCurrent(href) ? "page" : undefined);
---

<header class="header">
  <a href="/">
    <span class="logo">
      <Image src={logo} alt="" class="logo__image" loading="eager" />
      Suicide<span class="logo__accent">By</span>Star
    </span>
  </a>
  <div class="header__menu-mobile">
    <div class="bm-overlay"></div>
    <div class="bm-burger-button">
      <button
        type="button"
        class="bm-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      ></button>
      <span class="bm-burger-bars"></span>
      <span class="bm-burger-bars"></span>
      <span class="bm-burger-bars"></span>
    </div>
    <div id="mobile-menu" class="bm-menu-wrap" aria-hidden="true" inert>
      <div class="bm-menu">
        <nav class="bm-item-list" aria-label="Principal">
          <a class="bm-item menu-item" href="/" aria-current={ariaCurrent("/")}>
            Inicio
          </a>
          {sections.map(({ href, label }) => (
            <a class="bm-item menu-item" href={href} aria-current={ariaCurrent(href)}>
              {label}
            </a>
          ))}
          <a
            class="bm-item menu-item"
            href={archiveUrl}
            target="_blank"
            rel="noreferrer"
          >
            Archivo<NewTabNote />
          </a>
        </nav>
      </div>
      <div class="bm-cross-button">
        <button type="button" class="bm-toggle" aria-label="Cerrar menú"
        ></button>
        <span class="bm-cross"></span>
        <span class="bm-cross"></span>
      </div>
    </div>
  </div>
  <nav class="header__menu-large" aria-label="Principal">
    <ul role="list">
      {sections.map(({ href, label }) => (
        <li>
          <a class="menu-item" href={href} aria-current={ariaCurrent(href)}>
            {label}
          </a>
        </li>
      ))}
      <li>
        <a class="menu-item" href={archiveUrl} target="_blank" rel="noreferrer">
          Archivo<NewTabNote />
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Replaces react-burger-menu (slide from the right).
  const container = document.querySelector<HTMLElement>(".header__menu-mobile");
  const menu = container?.querySelector<HTMLElement>(".bm-menu-wrap");
  const openButton = container?.querySelector<HTMLButtonElement>(
    ".bm-burger-button button",
  );

  if (container && menu && openButton) {
    const focusables = () =>
      menu.querySelectorAll<HTMLElement>("a[href], button");

    const setOpen = (isOpen: boolean) => {
      container.classList.toggle("is-open", isOpen);
      openButton.setAttribute("aria-expanded", String(isOpen));
      menu.setAttribute("aria-hidden", String(!isOpen));
      menu.inert = !isOpen;
      // The menu covers the page, so keyboard/screen reader focus follows it.
      if (isOpen) {
        focusables()[0]?.focus();
      } else {
        openButton.focus();
      }
    };

    openButton.addEventListener("click", () => setOpen(true));
    container
      .querySelector(".bm-cross-button button")
      ?.addEventListener("click", () => setOpen(false));
    container
      .querySelector(".bm-overlay")
      ?.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && container.classList.contains("is-open")) {
        setOpen(false);
      }
    });

    // Trap Tab inside the open menu, like a modal dialog.
    menu.addEventListener("keydown", (event) => {
      if (event.key !== "Tab") return;
      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
