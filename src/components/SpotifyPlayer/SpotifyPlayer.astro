---
interface Props {
  url: string;
  /** Episode title, used for the iframe's accessible name. */
  title?: string;
}

const { url, title } = Astro.props;
---

<iframe
  src={url}
  width="90%"
  height="380"
  allow="encrypted-media"
  style="border: 0"
  loading="lazy"
  title={title ? `Lista de Spotify: ${title}` : "Lista de Spotify"}
></iframe>
