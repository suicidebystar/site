---
import PostCard from "../PostCard/PostCard.astro";
import type { Post } from "../../lib/posts";
import "./PostList.scss";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<section class="post-list">
  {posts.map((post) => (
    <PostCard post={post} />
  ))}
</section>
