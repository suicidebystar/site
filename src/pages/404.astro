---
import BaseLayout from "../layouts/BaseLayout.astro";
import Page from "../components/Page/Page.astro";
import Content from "../components/Content/Content.astro";

const title = "Página no encontrada";
---

<BaseLayout title={title}>
  <Page title={title}>
    <Content>
      <p>
        <strong>Oops 😰</strong>
      </p>
      <p>
        No hemos encontrado lo que buscabas. Acabamos de cambiar la web y muchas
        cosas se han movido de sitio.
      </p>
      <ul>
        <li>
          📖 Si estás buscando un <strong>artículo de la antigua web</strong>,
          lo puedes encontrar en nuestro{" "}
          <strong>
            <a href="https://archivo.suicidebystar.sbs">archivo</a>
          </strong>
        </li>
        <li>
          🎙 Para los <strong>podcasts</strong>, dirigete a nuestra{" "}
          <a href="/">
            <strong>página principal</strong>
          </a>
        </li>
      </ul>
    </Content>
  </Page>
</BaseLayout>
